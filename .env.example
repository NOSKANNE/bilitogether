# ============================================================
# BiliTogether 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# 【必需】SQLite 数据库文件位置（房间、播放列表、观看统计）
# 建议放在项目根目录的 db/ 下，目录不存在请先创建
DATABASE_URL=file:./db/custom.db

# 【可选】B站凭据（不配置也可以，站点内扫码登录会自动写入 data/bili-credentials.json）
# - BILI_SESSDATA：登录凭据，未登录时画质上限 720P，登录后普通账号 1080P（大会员可达 1080P+/4K）
# - BILI_BILI_JCT：发送弹幕需要（扫码登录会自动抓取，一般无需手工配置）
# BILI_SESSDATA=
# BILI_BILI_JCT=

# 【可选】同步服务（socket.io）连接地址，构建时注入前端
# - 不配置：默认走 Caddy 网关转发 /?XTransformPort=3003（沙箱/网关式部署）
# - 同源反代自托管（推荐）：设为 / ，并在 nginx/caddy 把 /socket.io/ 反代到 127.0.0.1:3003
# - 直连自托管：设为 http://你的服务器IP:3003 （适合局域网，服务端 CORS 已放开）
# NEXT_PUBLIC_SYNC_URL=/

# 【可选】同步服务回访 Next.js REST API 的地址（默认 http://127.0.0.1:3000，
# 仅当 Next.js 不跑在 3000 端口时需要配置，供同步服务持久化房间数据用）
# NEXT_API_URL=http://127.0.0.1:3000
